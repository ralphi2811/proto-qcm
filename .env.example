# Génération de QCM par IA (facultatif) — copier en .env et compléter.
# Clé : https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Modèle multimodal (lit les images et les PDF scannés) avec sortie JSON structurée.
# Plus économique : openai/gpt-6-luna  ·  liste : https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Code d'accès à demander dans l'app avant toute génération (recommandé si le serveur
# est accessible depuis Internet, pour protéger vos crédits). Vide = pas de code.
AI_ACCESS_CODE=

# Point d'accès compatible OpenAI (facultatif) : autre fournisseur, ou modèle local
# (ex. Ollama : http://localhost:11434/v1). Vide = OpenRouter.
OPENROUTER_BASE_URL=

# ---- Déploiement (docker compose) -------------------------------------------
# Jeton du tunnel : Cloudflare Zero Trust → Networks → Tunnels → Create (Cloudflared)
# → copier le jeton de la commande d'installation. Nom d'hôte public → http://app:8000
CLOUDFLARE_TUNNEL_TOKEN=

# Version de l'image (latest = dernière version de main ; ou sha-xxxxxxx, ou 1.2.0)
QCM_TAG=latest
# Processus uvicorn (PDF et lecture des copies sont gourmands en CPU)
WEB_CONCURRENCY=2
# Port local (127.0.0.1) pour accéder à l'app sans passer par le tunnel
QCM_PORT=8000
